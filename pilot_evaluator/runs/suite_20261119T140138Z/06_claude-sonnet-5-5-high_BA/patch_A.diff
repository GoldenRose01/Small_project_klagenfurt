+ï»¿"""Visibility policy for reports."""
+
+from collections.abc import Iterable
+from .models import Report
+
+
+def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
+    """Return reports visible to a user with the given group memberships.
+
+    A report is visible only if its ``group`` is in ``user_groups``. Input order
+    is preserved, inputs are not mutated, and an empty (or missing)
+    ``user_groups`` or ``reports`` yields an empty list.
+    """
+    if not user_groups or not reports:
+        return []
+    # Materialise once so one-shot iterables (e.g. generators) are handled.
+    allowed = set(user_groups)
+    if not allowed:
+        return []
+    return [r for r in reports if r.get("group") in allowed]
