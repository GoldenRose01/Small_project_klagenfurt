+ï»¿"""Visibility policy for reports."""
+
+from collections.abc import Iterable
+from .models import Report
+
+
+def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
+    """Return reports whose group is one of `user_groups`.
+
+    The original order of `reports` is preserved and inputs are not mutated.
+    Returns an empty list if `user_groups` or `reports` is empty.
+    """
+    allowed = set(user_groups)  # materialize once (also supports iterators)
+    if not allowed or not reports:
+        return []
+    return [r for r in reports if r.get("group") in allowed]
