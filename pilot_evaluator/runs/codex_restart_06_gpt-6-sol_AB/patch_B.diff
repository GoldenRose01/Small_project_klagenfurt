@@ -0,0 +1,40 @@
+"""Checks for report visibility through both public entry points."""
+
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports = [
+            {"id": "1", "group": "beta", "title": "First"},
+            {"id": "2", "group": "alpha", "title": "Second"},
+            {"id": "3", "group": "beta", "title": "Third"},
+            {"id": "4", "group": "gamma", "title": "Fourth"},
+        ]
+
+    def test_filters_by_group_and_preserves_order(self) -> None:
+        self.assertEqual(
+            visible_reports(["beta", "alpha"], self.reports),
+            self.reports[:3],
+        )
+
+    def test_empty_inputs_return_empty_lists(self) -> None:
+        self.assertEqual(visible_reports([], self.reports), [])
+        self.assertEqual(visible_reports(["alpha"], []), [])
+        self.assertEqual(list_user_reports({"id": "u", "groups": []}, self.reports), [])
+
+    def test_service_filters_without_mutating_inputs(self) -> None:
+        user = {"id": "u", "groups": ["beta"]}
+        original_reports = [report.copy() for report in self.reports]
+        result = list_user_reports(user, self.reports)
+
+        self.assertEqual(result, [self.reports[0], self.reports[2]])
+        self.assertEqual(user, {"id": "u", "groups": ["beta"]})
+        self.assertEqual(self.reports, original_reports)
+        self.assertIsNot(result, self.reports)
+
+
+if __name__ == "__main__":
+    unittest.main()
