+"""Unit tests for group-based report visibility."""
+
+import copy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+from reporting.models import Report, User
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports: list[Report] = [
+            {"id": "r1", "group": "alpha", "title": "Alpha Q1"},
+            {"id": "r2", "group": "beta", "title": "Beta Audit"},
+            {"id": "r3", "group": "gamma", "title": "Gamma Ops"},
+            {"id": "r4", "group": "alpha", "title": "Alpha Q2"},
+            {"id": "r5", "group": "beta", "title": "Beta Forecast"},
+        ]
+
+    def test_visible_reports_filters_by_single_group(self) -> None:
+        result = visible_reports(["alpha"], self.reports)
+        self.assertEqual([r["id"] for r in result], ["r1", "r4"])
+
+    def test_visible_reports_filters_by_multiple_groups_preserving_order(self) -> None:
+        result = visible_reports(["beta", "alpha"], self.reports)
+        self.assertEqual([r["id"] for r in result], ["r1", "r2", "r4", "r5"])
+
+    def test_visible_reports_duplicate_user_groups_no_duplicate_results(self) -> None:
+        result = visible_reports(["alpha", "alpha"], self.reports)
+        self.assertEqual([r["id"] for r in result], ["r1", "r4"])
+
+    def test_visible_reports_accepts_generator(self) -> None:
+        groups_gen = (g for g in ["gamma", "alpha"])
+        result = visible_reports(groups_gen, self.reports)
+        self.assertEqual([r["id"] for r in result], ["r1", "r3", "r4"])
+
+    def test_visible_reports_empty_user_groups_returns_empty_list(self) -> None:
+        self.assertEqual(visible_reports([], self.reports), [])
+        self.assertEqual(visible_reports(iter([]), self.reports), [])
+
+    def test_visible_reports_empty_reports_returns_empty_list(self) -> None:
+        self.assertEqual(visible_reports(["alpha"], []), [])
+        self.assertEqual(visible_reports([], []), [])
+
+    def test_visible_reports_no_matching_groups_returns_empty_list(self) -> None:
+        self.assertEqual(visible_reports(["delta"], self.reports), [])
+
+    def test_visible_reports_is_case_sensitive(self) -> None:
+        self.assertEqual(visible_reports(["Alpha"], self.reports), [])
+
+    def test_list_user_reports_filters_for_user_groups(self) -> None:
+        user: User = {"id": "u1", "groups": ["gamma", "beta"]}
+        result = list_user_reports(user, self.reports)
+        self.assertEqual([r["id"] for r in result], ["r2", "r3", "r5"])
+
+    def test_list_user_reports_empty_groups_returns_empty_list(self) -> None:
+        user: User = {"id": "u_empty", "groups": []}
+        self.assertEqual(list_user_reports(user, self.reports), [])
+
+    def test_inputs_are_not_mutated(self) -> None:
+        user_groups = ["beta", "alpha"]
+        user: User = {"id": "u1", "groups": ["beta", "alpha"]}
+        reports = copy.deepcopy(self.reports)
+
+        expected_groups = copy.deepcopy(user_groups)
+        expected_user = copy.deepcopy(user)
+        expected_reports = copy.deepcopy(reports)
+
+        visible_reports(user_groups, reports)
+        list_user_reports(user, reports)
+
+        self.assertEqual(user_groups, expected_groups)
+        self.assertEqual(user, expected_user)
+        self.assertEqual(reports, expected_reports)
+
+
+if __name__ == "__main__":
+    unittest.main()
