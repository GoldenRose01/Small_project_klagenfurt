+"""Visibility policy for reports."""
+
+from collections.abc import Iterable
+from typing import Optional
+
+from .models import Report
+
+
+def visible_reports(
+    user_groups: Optional[Iterable[str]], reports: Optional[list[Report]]
+) -> list[Report]:
+    """Return reports visible to a user with the given group memberships.
+
+    A report is visible only if its ``group`` value is exactly one of
+    ``user_groups`` (case-sensitive string match). Visibility is deny-by-default:
+
+    - an empty (or ``None``) ``user_groups`` yields an empty list;
+    - an empty (or ``None``) ``reports`` yields an empty list;
+    - reports with a missing or non-string ``group`` are never visible.
+
+    The result is a new list that preserves the original order of ``reports``.
+    Neither argument is mutated (``user_groups`` is consumed exactly once, so
+    one-shot iterables such as generators are supported).
+
+    Raises:
+        TypeError: if ``user_groups`` is a single string rather than a
+            collection of group names, to avoid accidentally treating each
+            character as a group.
+    """
+    if isinstance(user_groups, (str, bytes)):
+        raise TypeError("user_groups must be an iterable of group names, not a string")
+    if not user_groups or not reports:
+        return []
+
+    allowed = {group for group in user_groups if isinstance(group, str)}
+    if not allowed:
+        return []
+
+    return [
+        report
+        for report in reports
+        if isinstance(report.get("group"), str) and report["group"] in allowed
+    ]
