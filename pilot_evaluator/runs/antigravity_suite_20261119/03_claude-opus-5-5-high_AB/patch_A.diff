+"""Tests for group-based report visibility."""
+
+import copy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+from reporting.sample_data import SAMPLE_REPORTS, SAMPLE_USERS
+
+REPORTS = [
+    {"id": "r1", "group": "alpha", "title": "A1"},
+    {"id": "r2", "group": "beta", "title": "B1"},
+    {"id": "r3", "group": "gamma", "title": "G1"},
+    {"id": "r4", "group": "alpha", "title": "A2"},
+    {"id": "r5", "group": "beta", "title": "B2"},
+]
+
+
+def ids(reports):
+    return [r["id"] for r in reports]
+
+
+class VisibleReportsTests(unittest.TestCase):
+    def test_filters_by_single_group(self) -> None:
+        self.assertEqual(ids(visible_reports(["alpha"], REPORTS)), ["r1", "r4"])
+
+    def test_filters_by_multiple_groups_preserving_order(self) -> None:
+        # Group order in user_groups must not affect output order.
+        self.assertEqual(
+            ids(visible_reports(["beta", "alpha"], REPORTS)), ["r1", "r2", "r4", "r5"]
+        )
+
+    def test_empty_user_groups(self) -> None:
+        self.assertEqual(visible_reports([], REPORTS), [])
+
+    def test_empty_reports(self) -> None:
+        self.assertEqual(visible_reports(["alpha"], []), [])
+
+    def test_none_inputs_return_empty(self) -> None:
+        self.assertEqual(visible_reports(None, REPORTS), [])
+        self.assertEqual(visible_reports(["alpha"], None), [])
+
+    def test_no_matching_group(self) -> None:
+        self.assertEqual(visible_reports(["delta"], REPORTS), [])
+
+    def test_exact_case_sensitive_match(self) -> None:
+        self.assertEqual(visible_reports(["Alpha", "alph", "alpha "], REPORTS), [])
+
+    def test_accepts_any_iterable(self) -> None:
+        self.assertEqual(ids(visible_reports(("gamma",), REPORTS)), ["r3"])
+        self.assertEqual(ids(visible_reports({"gamma"}, REPORTS)), ["r3"])
+        self.assertEqual(ids(visible_reports((g for g in ["gamma"]), REPORTS)), ["r3"])
+
+    def test_string_user_groups_rejected(self) -> None:
+        with self.assertRaises(TypeError):
+            visible_reports("alpha", REPORTS)
+
+    def test_malformed_reports_are_hidden(self) -> None:
+        reports = [
+            {"id": "x1", "title": "no group"},
+            {"id": "x2", "group": None, "title": "null group"},
+            {"id": "x3", "group": ["alpha"], "title": "list group"},
+            {"id": "x4", "group": "alpha", "title": "ok"},
+        ]
+        self.assertEqual(ids(visible_reports(["alpha"], reports)), ["x4"])
+
+    def test_inputs_not_mutated(self) -> None:
+        groups = ["beta", "alpha"]
+        reports = copy.deepcopy(REPORTS)
+        groups_before = list(groups)
+        reports_before = copy.deepcopy(reports)
+        result = visible_reports(groups, reports)
+        self.assertEqual(groups, groups_before)
+        self.assertEqual(reports, reports_before)
+        self.assertIsNot(result, reports)
+
+    def test_returns_new_list_even_when_all_visible(self) -> None:
+        reports = [{"id": "r1", "group": "alpha", "title": "A1"}]
+        result = visible_reports(["alpha"], reports)
+        self.assertEqual(result, reports)
+        self.assertIsNot(result, reports)
+
+
+class ListUserReportsTests(unittest.TestCase):
+    def test_sample_users(self) -> None:
+        self.assertEqual(ids(list_user_reports(SAMPLE_USERS[0], SAMPLE_REPORTS)), ["r1"])
+        self.assertEqual(
+            ids(list_user_reports(SAMPLE_USERS[1], SAMPLE_REPORTS)), ["r1", "r2"]
+        )
+
+    def test_user_without_groups(self) -> None:
+        self.assertEqual(list_user_reports({"id": "u", "groups": []}, REPORTS), [])
+        self.assertEqual(list_user_reports({"id": "u"}, REPORTS), [])
+        self.assertEqual(list_user_reports({"id": "u", "groups": None}, REPORTS), [])
+
+    def test_user_not_mutated(self) -> None:
+        user = {"id": "u", "groups": ["gamma"]}
+        before = copy.deepcopy(user)
+        self.assertEqual(ids(list_user_reports(user, REPORTS)), ["r3"])
+        self.assertEqual(user, before)
+
+
+if __name__ == "__main__":
+    unittest.main()
