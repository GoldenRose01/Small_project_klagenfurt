+"""Visibility policy for reports."""
+
+from collections.abc import Iterable
+from typing import Optional
+
+from .models import Report
+
+
+def _normalize_groups(user_groups: Optional[Iterable[str]]) -> frozenset[str]:
+    """Build an immutable set of group names from `user_groups`.
+
+    - ``None`` or an empty iterable yields an empty set (no access).
+    - A bare string is treated as a single group name rather than being
+      iterated character by character (which would grant access to any
+      single-letter group).
+    - Non-string entries are ignored, so they can never match a group.
+    """
+    if not user_groups:
+        return frozenset()
+    if isinstance(user_groups, str):
+        return frozenset((user_groups,))
+    return frozenset(g for g in user_groups if isinstance(g, str))
+
+
+def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
+    """Return reports visible to a user with the given group memberships.
+
+    A report is visible only if its ``group`` is one of ``user_groups``.
+    The result is a new list preserving the original order of ``reports``;
+    neither argument is mutated. Returns an empty list when ``user_groups``
+    or ``reports`` is empty. Reports without a string ``group`` are never
+    visible (fail closed).
+    """
+    groups = _normalize_groups(user_groups)
+    if not groups or not reports:
+        return []
+    return [
+        report
+        for report in reports
+        if isinstance(report.get("group"), str) and report["group"] in groups
+    ]
