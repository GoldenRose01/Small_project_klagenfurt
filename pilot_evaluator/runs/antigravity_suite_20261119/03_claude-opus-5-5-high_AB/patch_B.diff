+"""Tests for group-based report visibility."""
+
+import copy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+REPORTS = [
+    {"id": "r1", "group": "alpha", "title": "Alpha Q1"},
+    {"id": "r2", "group": "beta", "title": "Beta Audit"},
+    {"id": "r3", "group": "gamma", "title": "Gamma Plan"},
+    {"id": "r4", "group": "alpha", "title": "Alpha Q2"},
+]
+
+
+def ids(reports):
+    return [r["id"] for r in reports]
+
+
+class VisibleReportsTests(unittest.TestCase):
+    def test_filters_by_group(self) -> None:
+        self.assertEqual(ids(visible_reports(["alpha"], REPORTS)), ["r1", "r4"])
+
+    def test_multiple_groups_preserve_input_order(self) -> None:
+        self.assertEqual(
+            ids(visible_reports(["gamma", "alpha"], REPORTS)), ["r1", "r3", "r4"]
+        )
+
+    def test_empty_groups(self) -> None:
+        self.assertEqual(visible_reports([], REPORTS), [])
+        self.assertEqual(visible_reports(set(), REPORTS), [])
+
+    def test_empty_reports(self) -> None:
+        self.assertEqual(visible_reports(["alpha"], []), [])
+
+    def test_unknown_group(self) -> None:
+        self.assertEqual(visible_reports(["delta"], REPORTS), [])
+
+    def test_exact_match_only(self) -> None:
+        self.assertEqual(visible_reports(["Alpha", "alph", "alpha "], REPORTS), [])
+
+    def test_bare_string_is_single_group(self) -> None:
+        reports = [{"id": "x", "group": "a", "title": "t"}] + REPORTS
+        self.assertEqual(ids(visible_reports("alpha", reports)), ["r1", "r4"])
+
+    def test_generator_groups(self) -> None:
+        self.assertEqual(
+            ids(visible_reports((g for g in ["beta"]), REPORTS)), ["r2"]
+        )
+
+    def test_missing_or_invalid_group_fails_closed(self) -> None:
+        reports = [
+            {"id": "a", "title": "no group"},
+            {"id": "b", "group": None, "title": "none"},
+            {"id": "c", "group": ["alpha"], "title": "list"},
+            {"id": "d", "group": "alpha", "title": "ok"},
+        ]
+        self.assertEqual(ids(visible_reports(["alpha"], reports)), ["d"])
+
+    def test_inputs_not_mutated(self) -> None:
+        groups = ["alpha", "beta"]
+        reports = copy.deepcopy(REPORTS)
+        groups_before = list(groups)
+        reports_before = copy.deepcopy(reports)
+        result = visible_reports(groups, reports)
+        self.assertEqual(groups, groups_before)
+        self.assertEqual(reports, reports_before)
+        self.assertIsNot(result, reports)
+
+    def test_returns_new_list_even_when_all_visible(self) -> None:
+        groups = ["alpha", "beta", "gamma"]
+        result = visible_reports(groups, REPORTS)
+        self.assertEqual(result, REPORTS)
+        self.assertIsNot(result, REPORTS)
+
+
+class ListUserReportsTests(unittest.TestCase):
+    def test_user_groups(self) -> None:
+        user = {"id": "u1", "groups": ["beta", "alpha"]}
+        self.assertEqual(ids(list_user_reports(user, REPORTS)), ["r1", "r2", "r4"])
+
+    def test_user_without_groups(self) -> None:
+        self.assertEqual(list_user_reports({"id": "u"}, REPORTS), [])
+        self.assertEqual(list_user_reports({"id": "u", "groups": []}, REPORTS), [])
+        self.assertEqual(list_user_reports({"id": "u", "groups": None}, REPORTS), [])
+
+    def test_user_not_mutated(self) -> None:
+        user = {"id": "u1", "groups": ["alpha"]}
+        before = copy.deepcopy(user)
+        list_user_reports(user, REPORTS)
+        self.assertEqual(user, before)
+
+
+if __name__ == "__main__":
+    unittest.main()
