"""Visibility policy for reports."""

from collections.abc import Iterable
from .models import Report


def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
    """Return reports visible to a user with the given group memberships.

    Starting baseline: returns all reports without applying group filtering.
    """
    return list(reports)
"""Data structures for users and reports (Python standard library only)."""

from typing import TypedDict


class Report(TypedDict):
    id: str
    group: str
    title: str


class User(TypedDict):
    id: str
    groups: list[str]
"""Synthetic sample data illustrating report and user structures."""

from .models import Report, User

SAMPLE_USERS: list[User] = [
    {"id": "u1", "groups": ["alpha"]},
    {"id": "u2", "groups": ["alpha", "beta"]},
]

SAMPLE_REPORTS: list[Report] = [
    {"id": "r1", "group": "alpha", "title": "Alpha Q1 Summary"},
    {"id": "r2", "group": "beta", "title": "Beta Audit"},
]
"""Public entry point for listing visible reports for a user."""

from .models import Report, User
from .policy import visible_reports


def list_user_reports(user: User, reports: list[Report]) -> list[Report]:
    """Return the reports visible to `user` in their original order."""
    return visible_reports(user.get("groups", []), reports)
"""Baseline smoke tests verifying repository startup and public interfaces."""

import unittest

from reporting import list_user_reports, visible_reports
from reporting.sample_data import SAMPLE_REPORTS, SAMPLE_USERS


class SmokeTests(unittest.TestCase):
    def test_sample_data_loads(self) -> None:
        self.assertEqual(len(SAMPLE_USERS), 2)
        self.assertEqual(len(SAMPLE_REPORTS), 2)

    def test_entry_points_return_lists(self) -> None:
        self.assertIsInstance(visible_reports(["alpha"], SAMPLE_REPORTS), list)
        self.assertIsInstance(list_user_reports(SAMPLE_USERS[0], SAMPLE_REPORTS), list)


if __name__ == "__main__":
    unittest.main()
