+"""Regression checks for group-based report visibility."""
+
+from copy import deepcopy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def test_group_visibility(self) -> None:
+        reports = [
+            {"id": "r3", "group": "beta", "title": "Third"},
+            {"id": "r1", "group": "alpha", "title": "First"},
+            {"id": "r2", "group": "beta", "title": "Second"},
+        ]
+        for groups, source, expected in [
+            (["beta"], reports, [reports[0], reports[2]]),
+            (["alpha", "beta", "beta"], reports, reports),
+            (["unknown"], reports, []),
+            ([], reports, []),
+            (["alpha"], [], []),
+            ([], [], []),
+        ]:
+            with self.subTest(groups=groups, reports=source):
+                user = {"id": "u1", "groups": groups}
+                before = deepcopy((user, source))
+                self.assertEqual(visible_reports(groups, source), expected)
+                self.assertEqual(list_user_reports(user, source), expected)
+                self.assertEqual((user, source), before)
+                self.assertEqual(visible_reports(iter(groups), source), expected)
