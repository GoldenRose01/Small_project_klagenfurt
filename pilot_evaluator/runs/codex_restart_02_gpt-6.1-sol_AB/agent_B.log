+"""Regression tests for report group authorization."""
+
+from copy import deepcopy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports = [
+            {"id": "1", "group": "beta", "title": "First"},
+            {"id": "2", "group": "private", "title": "Hidden"},
+            {"id": "3", "group": "alpha", "title": "Third"},
+            {"id": "4", "group": "beta", "title": "Fourth"},
+        ]
+
+    def test_filters_by_membership_in_original_order(self) -> None:
+        self.assertEqual(
+            visible_reports(["alpha", "beta", "alpha"], self.reports),
+            [self.reports[0], self.reports[2], self.reports[3]],
+        )
+
+    def test_empty_inputs_and_unmatched_groups(self) -> None:
+        self.assertEqual(visible_reports([], self.reports), [])
+        self.assertEqual(visible_reports(["alpha"], []), [])
+        self.assertEqual(visible_reports(["unknown"], self.reports), [])
+
+    def test_accepts_iterable_groups(self) -> None:
+        self.assertEqual(
+            visible_reports(iter(["beta"]), self.reports),
+            [self.reports[0], self.reports[3]],
+        )
+
+    def test_service_filters_without_mutating_inputs(self) -> None:
+        user = {"id": "user", "groups": ["alpha"]}
+        original_user = deepcopy(user)
+        original_reports = deepcopy(self.reports)
+
+        self.assertEqual(list_user_reports(user, self.reports), [self.reports[2]])
+        self.assertEqual(user, original_user)
+        self.assertEqual(self.reports, original_reports)
+
+    def test_service_with_no_memberships(self) -> None:
+        self.assertEqual(list_user_reports({"id": "user", "groups": []}, self.reports), [])
+        self.assertEqual(list_user_reports({"id": "user"}, self.reports), [])
+
+
+if __name__ == "__main__":
+    unittest.main()

