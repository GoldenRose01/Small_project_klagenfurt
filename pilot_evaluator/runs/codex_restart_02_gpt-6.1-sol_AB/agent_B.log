"""Visibility policy for reports."""

from collections.abc import Iterable
from .models import Report


def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
    """Return reports visible to a user with the given group memberships.

    Starting baseline: returns all reports without applying group filtering.
    """
    return list(reports)
"""Public entry point for listing visible reports for a user."""

from .models import Report, User
from .policy import visible_reports


def list_user_reports(user: User, reports: list[Report]) -> list[Report]:
    """Return the reports visible to `user` in their original order."""
    return visible_reports(user.get("groups", []), reports)
"""Data structures for users and reports (Python standard library only)."""

from typing import TypedDict


class Report(TypedDict):
    id: str
    group: str
    title: str


class User(TypedDict):
    id: str
    groups: list[str]
