+"""Regression tests for group-based report visibility."""
+
+from copy import deepcopy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports = [
+            {"id": "r1", "group": "beta", "title": "Beta report"},
+            {"id": "r2", "group": "private", "title": "Private report"},
+            {"id": "r3", "group": "alpha", "title": "Alpha report"},
+            {"id": "r4", "group": "beta", "title": "Another beta report"},
+        ]
+
+    def test_public_interfaces_filter_in_original_order(self) -> None:
+        groups = ["alpha", "beta"]
+        user = {"id": "u1", "groups": groups}
+        expected = [self.reports[0], self.reports[2], self.reports[3]]
+        original = deepcopy((user, self.reports))
+
+        self.assertEqual(visible_reports(groups, self.reports), expected)
+        self.assertEqual(list_user_reports(user, self.reports), expected)
+        self.assertEqual((user, self.reports), original)
+
+    def test_empty_inputs_and_unmatched_groups(self) -> None:
+        for groups, reports in [
+            ([], self.reports),
+            (["alpha"], []),
+            ([], []),
+            (["unknown"], self.reports),
+        ]:
+            with self.subTest(groups=groups, reports=reports):
+                self.assertEqual(visible_reports(groups, reports), [])
+                self.assertEqual(
+                    list_user_reports({"id": "u1", "groups": groups}, reports), []
+                )
+
+    def test_group_iterable_is_supported(self) -> None:
+        self.assertEqual(
+            visible_reports(iter(["beta"]), self.reports),
+            [self.reports[0], self.reports[3]],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
