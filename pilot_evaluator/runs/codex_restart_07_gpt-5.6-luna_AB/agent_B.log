from collections.abc import Iterable
from .models import Report


def visible_reports(user_groups: Iterable[str], reports: list[Report]) -> list[Report]:
    """Return reports whose groups match the user's memberships."""
    groups = set(user_groups)
    return [report for report in reports if report["group"] in groups]


