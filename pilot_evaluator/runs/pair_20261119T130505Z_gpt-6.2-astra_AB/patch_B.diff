@@ -0,0 +1,24 @@
+import unittest
+from copy import deepcopy
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def test_group_filter_preserves_order_and_inputs(self):
+        user = {"id": "u1", "groups": ["alpha", "beta"]}
+        reports = [
+            {"id": str(i), "group": group, "title": group}
+            for i, group in enumerate(["beta", "gamma", "alpha", "beta"])
+        ]
+        original_user, original_reports = deepcopy((user, reports))
+        expected = [reports[0], reports[2], reports[3]]
+
+        self.assertEqual(list_user_reports(user, reports), expected)
+        self.assertEqual(visible_reports(iter(user["groups"]), reports), expected)
+        self.assertEqual((user, reports), (original_user, original_reports))
+
+    def test_empty_inputs(self):
+        report = {"id": "1", "group": "alpha", "title": "Summary"}
+        self.assertEqual(visible_reports([], [report]), [])
+        self.assertEqual(visible_reports(["alpha"], []), [])
