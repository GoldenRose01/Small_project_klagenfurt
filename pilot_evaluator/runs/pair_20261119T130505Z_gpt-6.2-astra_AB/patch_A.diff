@@ -0,0 +1,21 @@
+import unittest
+from copy import deepcopy
+
+from reporting import list_user_reports, visible_reports
+from reporting.sample_data import SAMPLE_REPORTS
+
+
+class VisibilityTests(unittest.TestCase):
+    def test_group_filter_preserves_order_and_inputs(self):
+        user = {"id": "u1", "groups": ["alpha", "beta"]}
+        alpha, beta = deepcopy(SAMPLE_REPORTS)
+        reports = [beta, {"id": "r3", "group": "gamma", "title": "Private"}, alpha]
+        original_inputs = deepcopy((user, reports))
+
+        self.assertEqual(list_user_reports(user, reports), [beta, alpha])
+        self.assertEqual(visible_reports(iter(user["groups"]), reports), [beta, alpha])
+        self.assertEqual((user, reports), original_inputs)
+
+    def test_empty_inputs(self):
+        self.assertEqual(visible_reports([], SAMPLE_REPORTS), [])
+        self.assertEqual(visible_reports(["alpha"], []), [])
