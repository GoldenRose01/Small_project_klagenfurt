+"""Regression checks for group-based report visibility."""
+
+from copy import deepcopy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def test_group_filter_preserves_order_and_inputs(self) -> None:
+        reports = [
+            {"id": "r1", "group": "beta", "title": "First"},
+            {"id": "r2", "group": "private", "title": "Hidden"},
+            {"id": "r3", "group": "alpha", "title": "Third"},
+            {"id": "r4", "group": "beta", "title": "Fourth"},
+        ]
+        user = {"id": "u1", "groups": ["alpha", "beta", "beta"]}
+        original = deepcopy((user, reports))
+        expected = [reports[0], reports[2], reports[3]]
+
+        self.assertEqual(visible_reports(user["groups"], reports), expected)
+        self.assertEqual(visible_reports(iter(user["groups"]), reports), expected)
+        self.assertEqual(list_user_reports(user, reports), expected)
+        self.assertEqual((user, reports), original)
+
+    def test_empty_and_unmatched_inputs(self) -> None:
+        reports = [{"id": "r1", "group": "alpha", "title": "Report"}]
+        for groups, items in [([], reports), (["alpha"], []), ([], []), (["beta"], reports)]:
+            with self.subTest(groups=groups, reports=items):
+                self.assertEqual(visible_reports(groups, items), [])
+                self.assertEqual(list_user_reports({"id": "u1", "groups": groups}, items), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
