+"""Regression tests for group-based report visibility."""
+
+import unittest
+from copy import deepcopy
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports = [
+            {"id": "1", "group": "beta", "title": "First"},
+            {"id": "2", "group": "private", "title": "Restricted"},
+            {"id": "3", "group": "alpha", "title": "Third"},
+            {"id": "4", "group": "beta", "title": "Fourth"},
+        ]
+
+    def test_public_interfaces_filter_in_original_order_without_mutation(self) -> None:
+        user = {"id": "user", "groups": ["alpha", "beta"]}
+        original_user = deepcopy(user)
+        original_reports = deepcopy(self.reports)
+        expected = [self.reports[0], self.reports[2], self.reports[3]]
+
+        self.assertEqual(visible_reports(user["groups"], self.reports), expected)
+        self.assertEqual(list_user_reports(user, self.reports), expected)
+        self.assertEqual(user, original_user)
+        self.assertEqual(self.reports, original_reports)
+
+    def test_empty_and_unmatched_memberships(self) -> None:
+        for groups in ([], ["unknown"], ["ALPHA"]):
+            with self.subTest(groups=groups):
+                self.assertEqual(visible_reports(groups, self.reports), [])
+                self.assertEqual(
+                    list_user_reports({"id": "user", "groups": groups}, self.reports), []
+                )
+
+    def test_empty_reports(self) -> None:
+        self.assertEqual(visible_reports(["alpha"], []), [])
+        self.assertEqual(list_user_reports({"id": "user", "groups": ["alpha"]}, []), [])
+
+    def test_iterable_memberships(self) -> None:
+        self.assertEqual(
+            visible_reports(iter(["beta"]), self.reports),
+            [self.reports[0], self.reports[3]],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()

