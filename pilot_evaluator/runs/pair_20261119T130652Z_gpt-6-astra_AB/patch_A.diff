+"""Regression tests for group-based report visibility."""
+
+from copy import deepcopy
+import unittest
+
+from reporting import list_user_reports, visible_reports
+
+
+class VisibilityTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.reports = [
+            {"id": "1", "group": "beta", "title": "First"},
+            {"id": "2", "group": "other", "title": "Hidden"},
+            {"id": "3", "group": "alpha", "title": "Third"},
+            {"id": "4", "group": "beta", "title": "Fourth"},
+        ]
+
+    def test_membership_order_and_inputs_through_both_interfaces(self) -> None:
+        user = {"id": "user", "groups": ["alpha", "beta", "beta"]}
+        original_user = deepcopy(user)
+        original_reports = deepcopy(self.reports)
+        expected = [self.reports[0], self.reports[2], self.reports[3]]
+
+        for result in (
+            visible_reports(user["groups"], self.reports),
+            list_user_reports(user, self.reports),
+        ):
+            self.assertEqual(result, expected)
+            self.assertIsNot(result, self.reports)
+
+        self.assertEqual(user, original_user)
+        self.assertEqual(self.reports, original_reports)
+
+    def test_empty_and_nonmatching_inputs(self) -> None:
+        for groups, reports in (
+            ([], self.reports),
+            (["alpha"], []),
+            ([], []),
+            (["unknown"], self.reports),
+        ):
+            with self.subTest(groups=groups, reports=reports):
+                self.assertEqual(visible_reports(groups, reports), [])
+                self.assertEqual(list_user_reports({"id": "user", "groups": groups}, reports), [])
+
+    def test_group_iterables(self) -> None:
+        self.assertEqual(
+            visible_reports(iter(["beta"]), self.reports),
+            [self.reports[0], self.reports[3]],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
